# ── Site selection ──────────────────────────────────────────
# "pj"   → jurisprudencia.pj.gob.pe  (requires VPN to Peru)
# "oefa" → publico.oefa.gob.pe       (no VPN needed)
PROFILE=oefa

# ── PJ site config ─────────────────────────────────────────
# PJ_BASE_URL=https://jurisprudencia.pj.gob.pe/jurisprudenciaweb
# PJ_SEARCH_TERM=contrato de trabajo

# ── OEFA site config ───────────────────────────────────────
# OEFA_BASE_URL=https://publico.oefa.gob.pe/repdig
# OEFA_SECTOR=  (empty = all sectors)

# ── Scraping behavior ──────────────────────────────────────
MAX_PAGES=3
MAX_DOCUMENTS=0
REQUEST_DELAY_MS=1500
REQUEST_TIMEOUT_MS=60000
RETRY_MAX=5
RETRY_BACKOFF_MS=1000
DOWNLOAD_PDFS=1
